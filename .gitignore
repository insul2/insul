# Dependências de Pacotes (Node Modules)
node_modules/
backend/node_modules/
frontend/node_modules/

# Arquivos Gigantes de Datasets Brutos (Excedem 50MB/100MB do GitHub)
data/*
!data/tbca_scraped_foods.json
database/seeds/001_seed_unified_foods.sql
database/seeds/002_seed_usda_full_foods.sql
*.csv
*.xlsx

# Variáveis de Ambiente e Segredos (NUNCA SUBIR PRO GIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Bundles de Build e Distribuição
dist/
frontend/dist/
build/
frontend/build/

# Logs e Relatórios de Execução
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Arquivos de Sistema Operacional (Windows / macOS)
